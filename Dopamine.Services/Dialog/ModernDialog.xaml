<Window x:Class="Dopamine.Services.Dialog.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dopamine.Services.Dialog"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button" x:Key="DialogButton">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" 
            CornerRadius="12" 
            BorderBrush="#E0E0E0" 
            BorderThickness="1">

        <Grid>
            <!-- 标题栏 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="12,12,0,0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <DockPanel Height="52" Margin="20,0">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1F2937"/>

                    <Button DockPanel.Dock="Right" Width="32" Height="32" 
                            Background="Transparent" BorderThickness="0"
                            Click="CloseButton_Click" VerticalAlignment="Center">
                        <Path Data="M4 4L20 20M20 4L4 20" Stroke="#6B7280" StrokeThickness="2" Stretch="Uniform"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- 内容区域 -->
            <ContentPresenter Grid.Row="1" Margin="24,20" 
                              Content="{Binding Content, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- 按钮栏 -->
            <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="0,0,12,12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
                    <Button Content="取消" Style="{StaticResource DialogButton}" 
                            Background="#F3F4F6" Foreground="#374151"
                            Click="CancelButton_Click"/>

                    <Button Content="确定" Style="{StaticResource DialogButton}" 
                            Background="#3B82F6" Foreground="White"
                            Click="OkButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
