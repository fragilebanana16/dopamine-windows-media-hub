<UserControl x:Class="Dopamine.Views.FullPlayer.Memo.Privacy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Dopamine.Views.FullPlayer.Memo"
             mc:Ignorable="d" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!--                 左侧列表区                  -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#121224" BorderBrush="#222240" BorderThickness="0,0,1,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 搜索框 -->
                    <RowDefinition Height="*"/>
                    <!-- 列表 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 按钮 -->
                </Grid.RowDefinitions>

                <!-- 搜索框 -->
                <TextBox Grid.Row="0" Margin="0,0,0,15" Height="38" 
                         VerticalContentAlignment="Center" Padding="5,0"
                         Background="#1A1A30" Foreground="White" BorderBrush="#333366"/>

                <!-- 账号列表 (这里用硬编码写死两行作为结构演示，你可以换回绑定) -->
                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <!-- 第一项 -->
                    <ListBoxItem Margin="0,0,0,10">
                        <Border Background="#1A1A32" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="微信 (社交)" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="wang_xiaoming" Foreground="#8888A0" Margin="0,4,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </ListBoxItem>

                    <!-- 第二项 -->
                    <ListBoxItem Margin="0,0,0,10">
                        <Border Background="#1A1A32" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="招商银行 (金融)" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="6225 **** **** 8821" Foreground="#8888A0" Margin="0,4,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </ListBoxItem>
                </ListBox>

                <!-- 【增】添加记录按钮 -->
                <Button Grid.Row="2" Content="+ 添加记录" Height="42" Margin="0,15,0,0" 
                        Background="#5F5FEA" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!--                 右侧详情区                  -->
        <!-- ========================================== -->
        <Border Grid.Column="1" Padding="40,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 顶部标题与操作栏 -->
                    <RowDefinition Height="*"/>
                    <!-- 表单字段 -->
                </Grid.RowDefinitions>

                <!-- 1. 顶部操作栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <!-- 左侧：标题与网址 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="微信" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="qq.com" FontSize="14" Foreground="#66668A" Margin="15,0,0,2" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <!-- 右侧：按钮组（直接全部平铺，方便你后续直接绑定 Prism Command） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="编辑" Width="25" Height="32" Margin="4,0" Background="#252545" Foreground="White" BorderThickness="0"/>
                        <Button Content="删除" Width="25" Height="32" Margin="4,0" Background="#502020" Foreground="#FF6B6B" BorderThickness="0"/>
                        <Button Content="保存" Width="25" Height="32" Margin="4,0" Background="#1C3A27" Foreground="#6BFF94" BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <!-- 2. 表单内容 (用 ScrollViewer 包裹，用 Margin 撑开防止粘连) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" MinWidth="300" HorizontalAlignment="Left">

                        <!-- 账号字段 -->
                        <TextBlock Text="账号 / 用户名" Foreground="#66668A" Margin="0,0,0,8" FontSize="13"/>
                        <TextBox Height="40" Margin="0,0,0,24" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="#16162A" Foreground="White" BorderBrush="#252545"/>

                        <!-- 密码字段 -->
                        <TextBlock Text="密码" Foreground="#66668A" Margin="0,0,0,8" FontSize="13"/>
                        <TextBox Height="40" Margin="0,0,0,12" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="#16162A" Foreground="White" BorderBrush="#252545"/>

                        <!-- 快捷状态切换按钮组 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="👁️ 隐藏" Padding="12,6" Margin="0,0,8,0" Background="#1C1C38" Foreground="#8A8AFF" BorderThickness="0"/>
                            <Button Content="💡 提示" Padding="12,6" Margin="0,0,8,0" Background="#1C1C38" Foreground="#8A8AFF" BorderThickness="0"/>
                            <Button Content="👁️ 完整显示" Padding="12,6" Margin="0,0,8,0" Background="#1C1C38" Foreground="#8A8AFF" BorderThickness="0"/>
                        </StackPanel>

                        <!-- 密码强度条指示 -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="4" Background="#00E676" Margin="0,0,4,0" CornerRadius="2"/>
                            <Border Grid.Column="1" Height="4" Background="#00E676" Margin="4,0,4,0" CornerRadius="2"/>
                            <Border Grid.Column="2" Height="4" Background="#00E676" Margin="4,0,4,0" CornerRadius="2"/>
                            <Border Grid.Column="3" Height="4" Background="#00E676" Margin="4,0,12,0" CornerRadius="2"/>
                            <TextBlock Grid.Column="4" Text="极强" FontSize="12" Foreground="#00E676" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 备注字段 -->
                        <TextBlock Text="备注" Foreground="#66668A" Margin="0,0,0,8" FontSize="13"/>
                        <TextBox Height="120" Margin="0,0,0,30" TextWrapping="Wrap" AcceptsReturn="True" Padding="8"
                                 Background="#16162A" Foreground="White" BorderBrush="#252545"/>

                        <!-- 底部元数据线 -->
                        <Border BorderBrush="#16162A" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕒 上次更新时间：" Foreground="#4A4A6B" FontSize="12"/>
                                <TextBlock Text="2024-11-20 14:23:01" Foreground="#4A4A6B" FontSize="12"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
