<UserControl x:Class="Dopamine.Views.FullPlayer.Memo.Privacy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Dopamine.Views.FullPlayer.Memo"
             xmlns:helpers="clr-namespace:Dopamine.Helpers"
             xmlns:pc="clr-namespace:Dopamine.Controls"
             mc:Ignorable="d" >
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#0F0F1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!--                 左侧列表区                  -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#15152A" BorderBrush="#242445" BorderThickness="0,0,1,0" Padding="14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 左侧列表：绑定到 AccountsView，SelectedItem 双向绑定 -->
                <Border HorizontalAlignment="Stretch" Background="{DynamicResource Brush_SearchBoxbackground}">
                    <pc:SearchBox x:Name="SearchBox"
                  HorizontalAlignment="Stretch" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" 
                  Background="{DynamicResource Brush_TextBoxBackgroundInvisible}"  
                  Foreground="{DynamicResource Brush_PrimaryText}" FontSize="15" />
                </Border>

                <!-- 1. 左右滑动标签层 -->
                    <ScrollViewer Grid.Row="1" 
                  HorizontalScrollBarVisibility="Hidden" 
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                  Margin="0,0,0,10">

                        <ListBox x:Name="TagListBox"
                 ItemsSource="{Binding Categories}"
                 SelectedValue="{Binding SelectedCategory}"
                 BorderThickness="0"
                 Background="Transparent">

                            <!-- 修改 ItemsPanel，让标签横向排列 -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- 美化标签样式（去除默认的ListBoxItem难看蓝底） -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TagBorder" 
                                        Background="#F3F3F3" 
                                        CornerRadius="15" 
                                        Padding="14,6" 
                                        Margin="2,8" 
                                        Cursor="Hand">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- 鼠标悬停 -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TagBorder" Property="Background" Value="#E5E5E5"/>
                                                    </Trigger>
                                                    <!-- 选中状态 -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TagBorder" Property="Background" Value="#0078D4"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>

                    <ListBox Grid.Row="2" ItemsSource="{Binding AccountsView}"
         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
         Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBg" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Bar" Grid.Column="0" Width="3" CornerRadius="2" Background="Transparent" Margin="0,0,10,0"/>
                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 选中态：背景高亮 + 左侧色条显示 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBg" Property="Background" Value="#1E1E42"/>
                                                    <Setter TargetName="Bar" Property="Background" Value="#7C7CFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBg" Property="Background" Value="#1A1A34"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                        <!-- 未保存新条目角标 -->
                                        <TextBlock Text=" ●" Foreground="#FFC107" FontSize="10"
                               Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Account}" Foreground="#7A7A9A" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                
                <!-- 添加记录按钮 -->
                <Button Grid.Row="3" Content="+  添加记录" Height="34" Margin="0,10,0,0"
                    Background="#5F5FEA" Foreground="White" FontWeight="SemiBold" FontSize="12"
                    BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!--                 右侧详情区                  -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#5F5FEA" CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="微" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedAccount.Title}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding SelectedAccount.Account}"  FontSize="11" Foreground="#5C5C7A"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="#1E1E38" CornerRadius="7" Margin="4,0" Cursor="Hand">
                        <TextBlock Text="✎" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Border>
                    <Border Width="30" Height="30" Background="#3A1E28" CornerRadius="7" Margin="4,0" Cursor="Hand">
                        <TextBlock Text="🗑" Foreground="#FF6B6B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 表单内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 账号：正常可编辑 TextBox -->
                    <TextBlock Text="账号 / 用户名" Foreground="#5C5C7A" Margin="0,0,0,6" FontSize="11"/>
                    <Border Background="#15152A" CornerRadius="7" Height="36" Margin="0,0,0,16" BorderBrush="#242445" BorderThickness="1">
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13"
                             VerticalContentAlignment="Center" Padding="10,0" Text="{Binding SelectedAccount.Account}"/>
                    </Border>

                    <!-- 密码：真正的显示/隐藏切换，用 PasswordBox + TextBox 叠放，
                     由 ToggleButton.IsChecked 触发 Visibility 互换 -->
                    <TextBlock Text="密码" Foreground="#5C5C7A" Margin="0,0,0,6" FontSize="11"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#15152A" CornerRadius="7" Height="36"
                            BorderBrush="#242445" BorderThickness="1">
                            <Grid>
                                <!-- 密文态：默认可见，勾选后隐藏 -->
                                <PasswordBox x:Name="PwdBox" 
                 helpers:PasswordBoxHelper.BindablePassword="{Binding SelectedAccount.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" Padding="10,8">
                                    <PasswordBox.Style>
                                        <Style TargetType="PasswordBox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ShowPwdToggle}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </PasswordBox.Style>
                                </PasswordBox>

                                <!-- 明文态：默认隐藏，勾选后可见 -->
                                <TextBox x:Name="PwdText" Background="Transparent" BorderThickness="0" Foreground="White"
         FontSize="13" VerticalContentAlignment="Center" Padding="10,0"
         Text="{Binding SelectedAccount.Password,
                   Mode=TwoWay,
                   UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ShowPwdToggle}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <ToggleButton Grid.Column="1" x:Name="ShowPwdToggle" Width="36" Height="36" Margin="8,0,0,0" Cursor="Hand">
                            <TextBlock Text="👁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="#1E1E38" CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#5F5FEA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <!-- 密码强度条 -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="3" Background="#00E676" Margin="0,0,3,0" CornerRadius="2"/>
                        <Border Grid.Column="1" Height="3" Background="#00E676" Margin="3,0,3,0" CornerRadius="2"/>
                        <Border Grid.Column="2" Height="3" Background="#00E676" Margin="3,0,3,0" CornerRadius="2"/>
                        <Border Grid.Column="3" Height="3" Background="#00E676" Margin="3,0,10,0" CornerRadius="2"/>
                        <TextBlock Grid.Column="4" Text="极强" FontSize="11" Foreground="#00E676" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 备注：正常可编辑多行 TextBox -->
                    <TextBlock Text="备注" Foreground="#5C5C7A" Margin="0,0,0,6" FontSize="11"/>
                    <Border Background="#15152A" CornerRadius="7" Height="70" Margin="0,0,0,16" BorderBrush="#242445" BorderThickness="1">
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🕒 2024-11-20 更新" Foreground="#4A4A6B" FontSize="11" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="保存修改" Width="100" Height="32"
                            Background="#5F5FEA" Foreground="White" FontWeight="SemiBold" FontSize="12"
                            BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
